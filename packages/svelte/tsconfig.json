{
  "include": [
    "src/**/*",
    "stories/stories.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "DOM"
    ],
    "module": "esNext",
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "paths": {
      "@teiler/core": ["../core/src"]
    }
  }
}
