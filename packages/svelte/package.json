{
  "name": "@teiler/svelte",
  "version": "0.0.29",
  "repository": {
    "url": "nerdslabs/teiler",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/nerdslabs/teiler/tree/master/packages/svelte#readme",
  "type": "module",
  "main": "dist/teiler-svelte.cjs.js",
  "module": "./dist/teiler-svelte.esm.js",
  "types": "./dist/teiler-svelte.d.ts",
  "exports": {
    ".": {
      "import": "./dist/teiler-svelte.esm.js",
      "require": "./dist/teiler-svelte.cjs.ts",
      "types": "./dist/teiler-svelte.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown --config",
    "dev": "rolldown --config --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook-test": "test-storybook --url http://localhost:6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@teiler/core": "0.0.28",
    "svelte": "^4.2.20"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/svelte": "^8.6.18",
    "@storybook/svelte-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "0.24.4",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@testing-library/svelte": "^4.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "storybook": "^8.6.18",
    "svelte-jester": "^5.0.0",
    "svelte-loader": "^3.2.4",
    "svelte-preprocess": "^5.1.4",
    "typescript": "^5.8.3"
  }
}
