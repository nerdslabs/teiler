{
  "name": "@teiler/svelte",
  "version": "0.0.29",
  "repository": {
    "url": "nerdslabs/teiler",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/nerdslabs/teiler/tree/master/packages/svelte#readme",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook-test": "test-storybook --url http://localhost:6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@teiler/core": "0.0.28"
  },
  "peerDependencies": {
    "svelte": "^5.16.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@jest/globals": "^29.7.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/svelte": "^10.6.0",
    "@storybook/svelte-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testing-library/svelte": "^5.4.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "storybook": "^10.6.0",
    "svelte": "^5.57.1",
    "svelte-jester": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
