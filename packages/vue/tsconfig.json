{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "DOM"
    ],
    "module": "esNext",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "experimentalDecorators": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "paths": {
      "@teiler/core": ["../core/src"]
    }
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "compileOnSave": false,
}